  {
    "name": "valid_standard_slurm_script",
    "accept": true,
    "lines": [
      "#!/bin/bash",
      "# aimip-generated v1",
      "#SBATCH --job-name=aimip-ace2-era5",
      "#SBATCH --partition=gpu",
      "#SBATCH --account=proj_gpu",
      "#SBATCH --gres=gpu:a100_80:1",
      "#SBATCH --cpus-per-task=32",
      "#SBATCH --hint=nomultithread",
      "#SBATCH --mem=64G",
      "#SBATCH --time=02:00:00",
      "#SBATCH --output={RUN_DIR}/slurm-%j.out",
      "#SBATCH --error={RUN_DIR}/slurm-%j.err",
      "",
      "set -euo pipefail",
      "\"{PREFIX}/bin/aimip\" exec-fme \"{RUN_DIR}\""
    ]
  },
